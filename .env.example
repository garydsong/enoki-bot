# ---------------------------------------------------------------------------
# Discord  (see README "Discord application setup")
# ---------------------------------------------------------------------------
# Bot token from the Developer Portal -> your app -> Bot -> Reset Token.
# REQUIRED from M1 onward. Never paste this anywhere but this file.
DISCORD_TOKEN=

# Developer Portal -> General Information -> Application ID.
DISCORD_APPLICATION_ID=

# Optional but strongly recommended in development: when set, slash commands
# register to this ONE server and appear instantly. Left blank, they register
# globally and take up to an hour to propagate.
#
# To find it: Discord -> User Settings -> Advanced -> enable Developer Mode,
# then right-click your server's icon in the sidebar -> Copy Server ID.
# (18-19 digits. Blank is fine — it means "register globally".)
DISCORD_DEV_GUILD_ID=

# Request the MessageContent privileged intent. Optional by design: it gates
# per-word XP mode, min_message_length and the effort booster. The bot runs
# correctly without it, and access can lapse via Discord's annual
# reapplication, so this is a capability rather than an assumption.
ENABLE_MESSAGE_CONTENT=true

# ---------------------------------------------------------------------------
# Database  (REQUIRED from M1 — run: docker compose up -d postgres)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://enoki:enoki@localhost:5432/enoki
POSTGRES_PASSWORD=enoki

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
HTTP_PORT=3000

# ---------------------------------------------------------------------------
# Retention  (spec `08` §5)
# ---------------------------------------------------------------------------
# How long OPERATIONAL data is kept. Member XP, statistics and configuration
# are never touched by retention — only these three.
#
# Audit entries: who changed what with /xp and /level.
RETENTION_AUDIT_DAYS=90
# Closed voice sessions. Their XP is already in member_xp; these rows only
# exist for debugging a crediting question after the fact.
RETENTION_VOICE_SESSION_DAYS=30
# Weekly/monthly XP buckets. 400 days keeps a full year of history plus a
# margin, so "last year's board" is still answerable.
RETENTION_PERIOD_XP_DAYS=400
